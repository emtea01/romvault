[Unit]
Description=ROM Vault - retro ROM browser and emulator front end
After=network-online.target remote-fs.target
Wants=network-online.target
RequiresMountsFor=/mnt/roms

[Service]
Type=simple
User=romvault
Group=romvault
WorkingDirectory=/opt/romvault
Environment=ROMS_PATH=/mnt/roms
ExecStart=/opt/romvault/venv/bin/gunicorn -w 1 -k gthread --threads 4 -b 0.0.0.0:5000 --timeout 1800 app:app
Restart=on-failure
RestartSec=5

# Light sandboxing (unprivileged LXC already isolates most of this)
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/romvault
ReadOnlyPaths=/mnt/roms
# /mnt/roms/boxart specifically needs to stay read-write, for manual box
# art drops and for Skyscraper's automatic scraping -- listed after the
# broader ReadOnlyPaths above so it takes precedence for that subtree
# specifically (systemd processes these path directives in declaration
# order; a later, more specific entry overrides an earlier, broader one
# for the overlapping subtree). Everything else under /mnt/roms (the
# actual ROM files) stays read-only.
ReadWritePaths=/mnt/roms/boxart

[Install]
WantedBy=multi-user.target
