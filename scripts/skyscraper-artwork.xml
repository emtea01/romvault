<?xml version="1.0" encoding="UTF-8"?>
<!--
  ROM Vault's Skyscraper artwork recipe.
  Per Skyscraper's own docs (ARTWORK.md / FAQ.md): an output with no
  nested layer exports that resource type raw, unresized and
  uncomposited. "resource" is only a valid attribute on layer, never on
  output directly; this file's first version incorrectly put it on
  output, which Skyscraper rejects as a parse error.
-->
<artwork>
  <output type="cover"/>
  <output type="screenshot"/>
</artwork>
